{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-simple-skills",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  // Workers AI: the only inference this app uses (free daily allowance).
  "ai": { "binding": "AI" },
  // One static page; the Worker only runs for /api/*.
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  // Commands are plain markdown prompts, bundled as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // `npm run dev:mock`: no AI binding, a fake streamed reply (works without a Cloudflare login).
  "env": { "mock": { "vars": { "MOCK_AI": "1" } } }
}
